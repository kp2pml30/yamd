#lang racket/base
;; std/table — an HTML-like table built from #table / #row / #cell.
;;
;;   #use(std/table)
;;   #table(header: 1)
;;     #row
;;       #cell: Name
;;       #cell: Role
;;     #row{Kiril}{infra}
;;
;; Structure (mirrors HTML): a #table contains #row children; a #row contains
;; #cell children. Two equivalent spellings of a row's cells are supported:
;;   * nested (HTML-like): a #row whose body is a run of #cell calls;
;;   * positional multi-body: #row{a}{b} — each {} brace body is one cell (the
;;     reader passes one positional argument per body).
;; `header: n` turns the first n rows into a <thead> of <th> cells; the rest go
;; into a <tbody> of <td> cells. Anything other than a #row directly under a
;; #table is an explicit error (no silent coercion).

(require yamd/runtime
         (only-in yamd/decode para-break?)
         (only-in racket/list append-map split-at))

(provide (rename-out [yamd-table table])
         row
         cell)

;; ---------------------------------------------------------------------------
;; Cell / row

;; #cell{…} / #cell: text — one table cell. Emits a <td>; #table promotes it to
;; <th> for header rows.
(define (cell . bodies)
  (apply elem 'td bodies))

;; #row — a table row (<tr>). Each body argument is inspected after dropping
;; structural whitespace / paragraph breaks: if it is made up solely of #cell
;; (<td>) elements they are spliced in as the row's cells (nested form); if it
;; contains no cell elements, the whole (unstripped) body becomes a single
;; cell (positional form, e.g. #row{a}{b}); a body mixing cells with other
;; content is an explicit error.
;;
;; This per-body rule is what unifies the two spellings: the nested block form
;;   #row
;;     #cell: a
;;     #cell: b
;; reaches `row` as ONE body containing both cells, so a body of cells must
;; splice. Deliberate consequence: a brace body that itself is a run of #cell
;; calls (#row{#cell{a}#cell{b}}) reads as the nested form (two cells), not as
;; one cell containing two <td>s — bare <td> inside a cell is not expressible
;; (HTML rejects it anyway).
;;
;; #row with no bodies yields an empty <tr>, and #table with no rows an empty
;; <table> — both valid HTML, deliberately allowed (rows may be generated by a
;; host-code loop over a possibly-empty list).
(define (row . bodies)
  (apply elem 'tr (append-map body->cells bodies)))

(define (body->cells body)
  (define raw-items (flatten-content* body))
  (define items (drop-structural raw-items))
  (define cells (filter cell-element? items))
  (cond
    [(null? cells) (list (apply elem 'td raw-items))]  ; whole body = one cell
    [(= (length cells) (length items)) cells]          ; all cells → splice
    [else
     (error 'row
            (string-append
             "a #row body must be either #cell elements or a single cell's "
             "content, not a mix; got ~e")
            items)]))

;; ---------------------------------------------------------------------------
;; Table

;; #table(header: n){…rows…}. Collects #row children, splits off the first n as
;; header rows (their cells become <th>), emits <thead>?/<tbody>.
(define (yamd-table #:header [header 0] . bodies)
  (unless (exact-nonnegative-integer? header)
    (error 'table
           "header: must be a non-negative integer (count of header rows), got ~e"
           header))
  (define rows (collect-rows (flatten-content* bodies)))
  (when (> header (length rows))
    (error 'table
           "header: ~a exceeds the ~a row(s) in the table"
           header (length rows)))
  (define-values (head-rows body-rows) (split-at rows header))
  (apply elem 'table
         (append
          (if (null? head-rows)
              '()
              (list (apply elem 'thead (map row->header-row head-rows))))
          (if (null? body-rows)
              '()
              (list (apply elem 'tbody body-rows))))))

;; Flatten the table body and keep only <tr> children; drop structural
;; whitespace / para-breaks; error on anything else.
(define (collect-rows items)
  (for/fold ([acc '()] #:result (reverse acc))
            ([c (in-list items)])
    (cond
      [(structural? c) acc]
      [(row-element? c) (cons c acc)]
      [else
       (error 'table "a #table may only contain #row children, got ~e" c)])))

;; A header row: same <tr>, but each <td> cell becomes a <th>.
(define (row->header-row tr)
  (element 'tr (element-attrs tr)
           (map td->th (element-children tr))
           (element-loc tr)))

(define (td->th c)
  (if (and (element? c) (eq? (element-tag c) 'td))
      (element 'th (element-attrs c) (element-children c) (element-loc c))
      c))

;; ---------------------------------------------------------------------------
;; Helpers

(define (flatten-content* c)
  (if (list? c) (append-map flatten-content* c) (list c)))

(define (structural? c)
  (or (and (string? c) (regexp-match? #px"^\\s*$" c))
      (para-break? c)))

(define (drop-structural items)
  (filter (lambda (c) (not (structural? c))) items))

(define (cell-element? c) (and (element? c) (eq? (element-tag c) 'td)))
(define (row-element? c) (and (element? c) (eq? (element-tag c) 'tr)))

;; ---------------------------------------------------------------------------

(module+ test
  (require rackunit)

  ;; positional multi-body: each body is one cell
  (check-equal? (row (list "a") (list "b"))
                (elem 'tr (elem 'td "a") (elem 'td "b")))

  ;; nested form: a body of #cell elements is spliced in as the row's cells
  (check-equal? (row (list (cell "a") "\n" (cell "b")))
                (elem 'tr (elem 'td "a") (elem 'td "b")))

  ;; a body mixing a cell with stray content is an error
  (check-exn #rx"not a mix"
             (lambda () (row (list (cell "a") "stray"))))

  ;; #table with a header row promotes that row's cells to <th>
  (check-equal?
   (yamd-table #:header 1
               (list (row (list "Name") (list "Role")))
               "\n"
               (list (row (list "Kiril") (list "infra"))))
   (elem 'table
         (elem 'thead (elem 'tr (elem 'th "Name") (elem 'th "Role")))
         (elem 'tbody (elem 'tr (elem 'td "Kiril") (elem 'td "infra")))))

  ;; no header → just a <tbody>
  (check-equal? (yamd-table (list (row (list "x"))))
                (elem 'table (elem 'tbody (elem 'tr (elem 'td "x")))))

  ;; non-#row child of #table is an explicit error
  (check-exn #rx"only contain #row children"
             (lambda () (yamd-table "stray")))
  (check-exn #rx"only contain #row children"
             (lambda () (yamd-table (list (cell "loose")))))

  ;; header count validation
  (check-exn #rx"exceeds the 1 row"
             (lambda () (yamd-table #:header 2 (list (row (list "x"))))))
  (check-exn #rx"non-negative integer"
             (lambda () (yamd-table #:header -1 (list (row (list "x")))))))
