# Ensure consistent line endings
* text=auto eol=lf

# Binary files — no diff, no merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.xz binary
*.wasm binary

# Golden expectation files are produced by `--bless`, not hand-authored —
# keep them out of language stats but still diffable in review.
tests/golden/** linguist-generated

# tree-sitter outputs are generated by `tree-sitter generate`; the runtime
# headers are vendored. Neither is hand-authored project code.
editors/tree-sitter-yamd/src/parser.c            linguist-generated
editors/tree-sitter-yamd/src/grammar.json        linguist-generated
editors/tree-sitter-yamd/src/node-types.json     linguist-generated
editors/tree-sitter-yamd/src/tree_sitter/**      linguist-vendored
