{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "yamd",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "block_call"
        },
        {
          "type": "SYMBOL",
          "name": "hanging_call"
        },
        {
          "type": "SYMBOL",
          "name": "colon_call"
        },
        {
          "type": "SYMBOL",
          "name": "text_line"
        },
        {
          "type": "SYMBOL",
          "name": "_blank_line"
        }
      ]
    },
    "_blank_line": {
      "type": "SYMBOL",
      "name": "_newline"
    },
    "block_call": {
      "type": "PREC_DYNAMIC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_call"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          },
          {
            "type": "SYMBOL",
            "name": "block"
          }
        ]
      }
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_indent"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_statement"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_dedent"
        }
      ]
    },
    "hanging_call": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_call"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "::"
            },
            "named": true,
            "value": "body_marker"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "hanging_body"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "hanging_body": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_statement"
        }
      }
    },
    "colon_call": {
      "type": "PREC_DYNAMIC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_call"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_colon"
            },
            "named": true,
            "value": "body_marker"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "body_line"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "body_line": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_inline"
      }
    },
    "text_line": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_inline"
            }
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_call"
        },
        {
          "type": "SYMBOL",
          "name": "host_escape"
        },
        {
          "type": "SYMBOL",
          "name": "escape"
        },
        {
          "type": "SYMBOL",
          "name": "line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "block_comment"
        },
        {
          "type": "SYMBOL",
          "name": "brace_group"
        },
        {
          "type": "SYMBOL",
          "name": "fence"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_stray"
        }
      ]
    },
    "_call": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "call_name"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "arguments"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "body"
            }
          }
        ]
      }
    },
    "call_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "#"
          },
          "named": true,
          "value": "sigil"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "[A-Za-z][A-Za-z0-9_-]*"
            }
          },
          "named": true,
          "value": "name"
        }
      ]
    },
    "arguments": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "("
            }
          },
          "named": true,
          "value": "paren_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "host"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": ")"
          },
          "named": true,
          "value": "paren_close"
        }
      ]
    },
    "host_escape": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "#"
          },
          "named": true,
          "value": "sigil"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "("
            }
          },
          "named": true,
          "value": "paren_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "host"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": ")"
          },
          "named": true,
          "value": "paren_close"
        }
      ]
    },
    "body": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "{"
            }
          },
          "named": true,
          "value": "brace_open"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_inline"
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "}"
          },
          "named": true,
          "value": "brace_close"
        }
      ]
    },
    "brace_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_inline"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "fence": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "fence_open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "fence_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "fence_close"
        }
      ]
    },
    "escape": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "STRING",
          "value": "##"
        }
      }
    },
    "line_comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "#;"
                },
                {
                  "type": "PATTERN",
                  "value": "[^{\\r\\n][^\\r\\n]*"
                }
              ]
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "#;"
                },
                {
                  "type": "PATTERN",
                  "value": "[\\r\\n]"
                }
              ]
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "#[ \\t][^\\r\\n]*"
            }
          }
        }
      ]
    },
    "_colon": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]"
          }
        ]
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^#{}|():\\r\\n]+"
      }
    },
    "_stray": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[#|():}]"
          }
        },
        "named": true,
        "value": "text"
      }
    },
    "host": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_host_content"
      }
    },
    "_host_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "host_string"
        },
        {
          "type": "SYMBOL",
          "name": "host_group"
        },
        {
          "type": "SYMBOL",
          "name": "markup_reentry"
        },
        {
          "type": "SYMBOL",
          "name": "host_code"
        },
        {
          "type": "SYMBOL",
          "name": "_host_hash"
        },
        {
          "type": "SYMBOL",
          "name": "_host_newline"
        }
      ]
    },
    "_host_newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\r?\\n[\\t ]*"
      }
    },
    "host_group": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "host"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "["
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "host"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "STRING",
              "value": "]"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "host"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "STRING",
              "value": "}"
            }
          ]
        }
      ]
    },
    "host_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "host_code": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^#()\\[\\]{}\"\\r\\n]+"
      }
    },
    "_host_hash": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "STRING",
          "value": "#"
        },
        "named": true,
        "value": "host_code"
      }
    },
    "markup_reentry": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "#"
          },
          "named": true,
          "value": "sigil"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[A-Za-z][A-Za-z0-9_-]*"
                }
              },
              "named": true,
              "value": "name"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "body"
        }
      ]
    }
  },
  "extras": [],
  "conflicts": [
    [
      "_inline",
      "block_call"
    ]
  ],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_newline"
    },
    {
      "type": "SYMBOL",
      "name": "_indent"
    },
    {
      "type": "SYMBOL",
      "name": "_dedent"
    },
    {
      "type": "SYMBOL",
      "name": "fence_open"
    },
    {
      "type": "SYMBOL",
      "name": "fence_content"
    },
    {
      "type": "SYMBOL",
      "name": "fence_close"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}