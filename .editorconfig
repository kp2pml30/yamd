root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = tab
tab_width = 2

[*.{json,yml,yaml,nix}]
indent_style = space
indent_size = 2

[*.{toml,rs,zig}]
indent_style = space
indent_size = 4

[*.rkt]
indent_style = space
indent_size = 2

[*.yamd]
indent_style = tab
